    "This app gets its own profile, so it's signed as %@ and installs next to your other apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل هذا التطبيق على ملف تعريف خاص به، لذا يتم توقيعه كـ %@ ويتم تثبيته بجانب تطبيقاتك الأخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato aplikace dostane vlastní profil, takže je podepsána jako %@ a nainstaluje se vedle vašich ostatních aplikací."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App erhält ihr eigenes Profil, damit sie als %@ signiert wird und neben deinen anderen Apps installiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app obtiene su propio perfil, así que se firma como %@ y se instala junto a tus otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application obtient son propre profil, elle est donc signée en tant que %@ et s'installe à côté de vos autres applications."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini mendapatkan profilnya sendiri, sehingga ditandatangani sebagai %@ dan terpasang di samping aplikasi Anda yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app ha il suo profilo, quindi viene firmata come %@ e si installa accanto alle tue altre app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 자체 프로파일을 가지므로 %@로 서명되어 다른 앱 옆에 설치됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja otrzymuje własny profil, więc jest podpisana jako %@ i instaluje się obok Twoich innych aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого приложения свой профиль, поэтому оно подписывается как %@ и устанавливается рядом с вашими другими приложениями."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama kendi profilini alır, bu yüzden %@ olarak imzalanır ve diğer uygulamalarınızın yanına kurulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng này có hồ sơ riêng, vì vậy nó được ký dưới dạng %@ và cài đặt bên cạnh các ứng dụng khác của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用获得自己的配置文件，因此它以 %@ 签名，并与您的其他应用并行安装。"
          }
        }
      }
    },
    "This app needs iOS %@ and this device runs %@. It will probably not open. You can lower the requirement under Advanced → Properties, but the app may still crash." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب هذا التطبيق iOS %@ وهذا الجهاز يعمل بـ %@. من المرجح ألا يفتح. يمكنك خفض المتطلب ضمن المتقدم → الخصائص، لكن التطبيق قد يتعطل trotzdem."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato aplikace vyžaduje iOS %@, ale toto zařízení běží na %@. Pravděpodobně se neotevře. Můžete snížit požadavek v části Pokročilé → Vlastnosti, ale aplikace může stále spádnout."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App benötigt iOS %@, dieses Gerät läuft jedoch mit %@. Sie wird sich wahrscheinlich nicht öffnen lassen. Die Anforderung lässt sich unter Erweitert → Eigenschaften verringern, aber die App könnte trotzdem abstürzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app necesita iOS %@ y este dispositivo tiene %@. Probablemente no se abrirá. Puedes reducir el requisito en Avanzado → Propiedades, pero la app aún podría fallar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app nécessite iOS %@ alors que cet appareil exécute %@. Elle ne s'ouvrira probablement pas. Vous pouvez réduire la version requise sous Avancé → Propriétés, mais l'app peut quand même planter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini memerlukan iOS %@ dan perangkat ini menjalankan %@. Mungkin tidak akan terbuka. Anda bisa menurunkan persyaratan di Lanjutan → Properti, tetapi aplikasi mungkin tetap mogok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app richiede iOS %@ e questo dispositivo esegue %@. Probabilmente non si aprirà. Puoi abbassare il requisito in Avanzate → Proprietà, ma l'app potrebbe comunque bloccarsi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 iOS %@가 필요하지만 이 기기는 %@를 실행 중입니다. 아마 열리지 않을 것입니다. 고급 → 속성에서 요구 사항을 낮출 수 있지만, 앱이 여전히 충돌할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja wymaga iOS %@, a to urządzenie ma %@. Prawdopodobnie nie otworzy się. Możesz obniżyć wymaganie w Zaawansowane → Właściwości, ale aplikacja może nadal się zawieszać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этому приложению нужен iOS %@, а на этом устройстве %@. Скорее всего, оно не откроется. Можно понизить требование в «Дополнительно» → «Свойства», но приложение всё равно может упасть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama iOS %@ gerektirir ve bu cihaz %@ çalıştırıyor. Muhtemelen açılmayacak. İleri Düzey → Özellikler altından gereksinimi düşürebilirsiniz, ancak uygulama yine de çökebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng này cần iOS %@ và thiết bị này chạy %@. Nó có thể sẽ không mở được. Bạn có thể giảm yêu cầu trong Nâng cao → Thuộc tính, nhưng ứng dụng vẫn có thể bị lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 App 需要 iOS %@，而当前设备运行的是 iOS %@。它很可能无法打开。你可以在“高级”→“属性”中降低要求，但 App 仍可能崩溃。"
          }
        }
      }
    },
    "This Apple ID already has as many development certificates as Apple allows. Revoking one stops apps signed with it from opening until they are signed again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرف Apple هذا لديه بالفعل العدد الأقصى من شهادات التطوير التي تسمح بها Apple. إلغاء واحدة يوقف التطبيقات الموقعة بها عن الفتح حتى يتم توقيعها مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento Apple ID již má tolik vývojářských certifikátů, kolik Apple povoluje. Odvolání jednoho zastaví otvírání aplikací podepsaných jím, dokud nebudou podepsány znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Apple ID hat bereits so viele Entwicklerzertifikate, wie Apple erlaubt. Das Widerrufen eines Zertifikats verhindert, dass damit signierte Apps geöffnet werden, bis sie erneut signiert wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Apple ID ya tiene todos los certificados de desarrollo que permite Apple. Si revocas uno, las apps firmadas con él dejarán de abrirse hasta que se vuelvan a firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet Apple ID possède déjà le nombre maximal de certificats de développement autorisés par Apple. En révoquer un empêche les applications signées avec de s'ouvrir jusqu'à ce qu'elles soient signées à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ID ini sudah memiliki sertifikat pengembangan sebanyak yang diizinkan Apple. Mencabut salah satunya akan menghentikan aplikasi yang ditandatangani dengannya agar tidak dapat dibuka hingga ditandatangani lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Apple ID ha già tanti certificati di sviluppo quanti Apple ne consente. Revocarne uno impedisce l'apertura delle app firmate con esso finché non vengono firmate di nuovo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple ID는 Apple이 허용하는 만큼의 개발 인증서를 이미 가지고 있습니다. 하나를 폐기하면 해당 인증서로 서명된 앱이 다시 서명될 때까지 열리지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Apple ID już ma tyle certyfikatów deweloperskich, ile pozwala Apple. Odwołanie jednego sprawia, że aplikacje podpisane nim przestaną się otwierać, dopóki nie zostaną podpisane ponownie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого Apple ID уже максимальное число сертификатов разработчика, допустимое Apple. Отзыв одного из них прекратит работу приложений, подписанных им, пока они не будут подписаны снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Apple ID zaten Apple'ın izin verdiği kadar geliştirici sertifikasına sahip. Birini iptal etmek, onunla imzalanmış uygulamaların yeniden imzalanana kadar açılmasını engeller."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ID này đã có số lượng chứng chỉ phát triển tối đa cho phép của Apple. Việc thu hồi một chứng chỉ sẽ khiến các ứng dụng được ký bằng nó ngừng mở cho đến khi được ký lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple ID 已拥有 Apple 允许的最大数量的开发证书。撤销一个证书会导致使用它签名的应用无法打开，直到重新签名。"
          }
        }
      }
    },
