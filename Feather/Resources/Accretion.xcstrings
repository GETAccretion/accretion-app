    "Free alternative: AltStore or SideStore with your own Apple ID (needs a computer once, apps refresh every 7 days)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بديل مجاني: AltStore أو SideStore مع Apple ID الخاص بك (يحتاج كمبيوتر مرة واحدة، تُحدّث التطبيقات كل 7 أيام)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma: AltStore nebo SideStore s vlastním Apple ID (počítač jednou, aplikace se obnovují každých 7 dní)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Alternative: AltStore oder SideStore mit deiner eigenen Apple ID (benötigt einmalig einen Computer, Apps werden alle 7 Tage aktualisiert)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativa gratuita: AltStore o SideStore con tu propio Apple ID (requiere un ordenador una vez, las apps se refrescan cada 7 días)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternative gratuite : AltStore ou SideStore avec votre propre identifiant Apple (nécessite un ordinateur une fois, les apps se rafraîchissent tous les 7 jours)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif gratis: AltStore atau SideStore dengan Apple ID Anda sendiri (perlu komputer sekali, aplikasi diperbarui setiap 7 hari)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativa gratuita: AltStore o SideStore con il tuo Apple ID (richiede un computer una volta, le app si aggiornano ogni 7 giorni)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 대안: 본인의 Apple ID로 AltStore 또는 SideStore 사용 (컴퓨터 1회 필요, 앱 7일마다 새로고침)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darmowa alternatywa: AltStore lub SideStore z własnym Apple ID (wymaga komputera raz, aplikacje odświeżają się co 7 dni)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатная альтернатива: AltStore или SideStore со своим Apple ID (требуется компьютер один раз, приложения обновляются каждые 7 дней)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz alternatif: Kendi Apple ID'inle AltStore veya SideStore (bir kez bilgisayar gerektirir, uygulamalar her 7 günde bir yenilenir)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lựa chọn miễn phí: AltStore hoặc SideStore với Apple ID của bạn (cần máy tính một lần, ứng dụng làm mới mỗi 7 ngày)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费替代方案：使用你自己的 Apple ID 配合 AltStore 或 SideStore（需一次电脑操作，应用每 7 天需刷新）。"
          }
        }
      }
    },
    "Free and open-source apps with mods built in by Accretion. Sign them with your own certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيقات مجانية ومفتوحة المصدر مع تعديلات مدمجة بواسطة Accretion. قم بتوقيعها باستخدام شهادتك الخاصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatné a open-source aplikace s mody zabudovanými Accretion. Podepište je svým vlastním certifikátem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose und Open-Source-Apps mit von Accretion integrierten Mods. Signieren Sie sie mit Ihrem eigenen Zertifikat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps gratuitas y de código abierto con mods integrados por Accretion. Fírmalas con tu propio certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps gratuites et open-source avec des mods intégrés par Accretion. Signez-les avec votre propre certificat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi gratis dan sumber terbuka dengan mod bawaan dari Accretion. Tandatangani dengan sertifikat Anda sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App gratuite e open-source con mod integrate da Accretion. Firmale con il tuo certificato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion이 내장한 모드가 있는 무료 오픈소스 앱입니다. 본인 인증서로 서명하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darmowe aplikacje open-source z wbudowanymi modami od Accretion. Podpisz je własnym certyfikatem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатные приложения с открытым кодом со встроенными модами от Accretion. Подпишите их своим сертификатом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion tarafından yerleşik modlarla birlikte ücretsiz ve açık kaynak uygulamalar. Bunları kendi sertifikanızla imzalayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng miễn phí và mã nguồn mở với các mod tích hợp sẵn bởi Accretion. Ký chúng bằng chứng chỉ của bạn."
          }
        },
        "zh-Hans" : {
