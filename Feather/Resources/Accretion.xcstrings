    "iOS started a secure connection to the install server but asked for nothing: it didn't accept the certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدأ iOS اتصالاً آمناً بخادم التثبيت لكنه لم يطلب شيئاً: لم يقبل الشهادة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zahájilo zabezpečené připojení k instalačnímu serveru, ale nic nepožádalo: nepřijalo certifikát."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat eine sichere Verbindung zum Installationsserver gestartet, aber nichts angefragt: Es hat das Zertifikat nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS inició una conexión segura con el servidor de instalación pero no pidió nada: no aceptó el certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a démarré une connexion sécurisée au serveur d'installation mais n'a rien demandé : il n'a pas accepté le certificat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS memulai koneksi aman ke server pemasangan tetapi tidak meminta apa pun: sertifikat tidak diterima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha avviato una connessione sicura al server di installazione ma non ha chiesto nulla: non ha accettato il certificato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 설치 서버와 보안 연결을 시작했으나 아무것도 요청하지 않음: 인증서를 수락하지 않았습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nawiązało bezpieczne połączenie z serwerem instalacji, ale nie żądało niczego: nie zaakceptowało certyfikatu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS установил безопасное соединение с сервером установки, но ничего не запросил: сертификат не был принят."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, yükleme sunucusuna güvenli bağlantı başlattı ama hiçbir şey istemedi: sertifikayı kabul etmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS đã bắt đầu kết nối an toàn đến máy chủ cài đặt nhưng không yêu cầu gì: nó không chấp nhận chứng chỉ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 向安装服务器发起安全连接但未请求任何内容：它不接受该证书。"
          }
        }
      }
    },
