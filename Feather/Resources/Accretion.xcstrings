    "Import your pairing file in Settings → JIT and connect LocalDevVPN, and Accretion turns JIT on itself. Or install StikDebug and set it up with the same pairing file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing-Datei in Einstellungen → JIT importieren und LocalDevVPN verbinden, dann aktiviert Accretion JIT selbst. Oder StikDebug installieren und mit derselben Pairing-Datei einrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa tu archivo de emparejamiento en Ajustes → JIT y conecta LocalDevVPN, y Accretion activará JIT por sí sola. O instala StikDebug y configúralo con el mismo archivo de emparejamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez votre fichier de jumelage dans Paramètres → JIT et connectez LocalDevVPN, et Accretion active JIT automatiquement. Ou installez StikDebug et configurez‑le avec le même fichier de jumelage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa il tuo file di pairing in Impostazioni → JIT e connetti LocalDevVPN, e Accretion attiverà JIT da solo. Oppure installa StikDebug e configuralo con lo stesso file di pairing."
          }
        }
      }
    },
