    "It stops opening in %@ days. Open Accretion → Settings → Apple ID → Re-sign All." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف عن الفتح خلال %@ أيام. افتح Accretion → الإعدادات → معرف Apple → إعادة توقيع الكل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestane se otevírat za %@ dní. Otevřete Accretion → Nastavení → Apple ID → Podepsat vše znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lässt sich in %@ Tagen nicht mehr öffnen. Öffnen Sie Accretion → Einstellungen → Apple ID → Alles neu signieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará de abrirse en %@ días. Abre Accretion → Ajustes → Apple ID → Volver a firmar todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'ouvrira plus dans %@ jours. Ouvrez Accretion → Paramètres → Apple ID → Re-signer tout."
          }
        },
        "id" : {
          "stringUnit" : {
