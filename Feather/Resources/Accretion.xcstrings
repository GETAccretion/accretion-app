    "Built-in JIT needs iOS 17.4 or newer. On this iOS, Open with JIT uses StikDebug." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب JIT المدمج iOS 17.4 أو أحدث. على هذا الـ iOS، يستخدم فتح مع JIT أداة StikDebug."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrovaný JIT vyžaduje iOS 17.4 nebo novější. Na tomto iOS používá Otevřít s JIT StikDebug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integriertes JIT benötigt iOS 17.4 oder neuer. Auf diesem iOS verwendet „Mit JIT öffnen“ StikDebug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT integrado requiere iOS 17.4 o posterior. En este iOS, Abrir con JIT usa StikDebug."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le JIT intégré nécessite iOS 17.4 ou version ultérieure. Sur cet iOS, Ouvrir avec JIT utilise StikDebug."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT bawaan butuh iOS 17.4 atau lebih baru. Di iOS ini, Buka dengan JIT menggunakan StikDebug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il JIT integrato richiede iOS 17.4 o successivo. Su questo iOS, Apri con JIT usa StikDebug."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 JIT은 iOS 17.4 이상이 필요합니다. 이 iOS에서는 JIT으로 열기가 StikDebug를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wbudowany JIT wymaga iOS 17.4 lub nowszego. Na tym iOS, Otwórz z JIT korzysta z StikDebug."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенный JIT требует iOS 17.4 или новее. На этом iOS «Открыть с JIT» использует StikDebug."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerleşik JIT iOS 17.4 veya daha yeni gerektirir. Bu iOS sürümünde, JIT ile Aç StikDebug kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT tích hợp cần iOS 17.4 trở lên. Trên iOS này, Mở với JIT dùng StikDebug."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
