    "Put tweaks into a decrypted IPA, then sign and install it, or export the modded IPA for another signer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع التعديلات في ملف IPA مفكوك التشفير، ثم قمه بتوقيعه وتثبيته، أو تصدير ملف IPA المعدل لأداة توقيع أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložte tweaky do dešifrované IPA, pak ji podepište a nainstalujte, nebo exportujte upravenou IPA pro jiný nástroj k podpisování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweaks in eine entschlüsselte IPA packen, dann signieren und installieren, oder die modifizierte IPA für einen anderen Signierer exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon tweaks en un IPA descifrado, luego fírmalo e instálalo, o exporta el IPA modificado para otro firmante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez des tweaks dans une IPA déchiffrée, puis signez et installez-la, ou exportez l'IPA modifiée pour un autre outil de signature."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan tweak ke IPA yang didekripsi, lalu tandatangani dan pasang, atau ekspor IPA yang dimodifikasi untuk penandatangan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci le modifiche in un IPA decriptato, poi firmalo e installalo, oppure esporta l'IPA modificato per un altro strumento di firma."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트윅을 복호화된 IPA에 넣은 뒤 서명하고 설치하거나, 수정된 IPA를 내보내 다른 서명기에 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść tweaks w odszyfrowanym IPA, następnie podpisz i zainstaluj, lub wyeksportuj zmodyfikowane IPA dla innego podpisującego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите твики в расшифрованный IPA, затем подпишите и установите его, или экспортируйте модифицированный IPA для другого подписанта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çözülmüş bir IPA'ya yamalar ekleyin, sonra imzalayın ve yükleyin, veya değiştirilmiş IPA'yı başka bir imzalayıcı için dışa aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa tweaks vào IPA đã giải mã, sau đó ký và cài đặt nó, hoặc xuất IPA đã mod cho người ký khác."
          }
        },
