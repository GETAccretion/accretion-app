    "Wait a few seconds for iOS to ask. If it never does, check Settings → Installation, or switch off iCloud Private Relay and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Sekunden warten, bis iOS fragt. Wenn nie, Einstellungen → Installation prüfen oder iCloud Private Relay ausschalten und erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera unos segundos a que iOS pregunte. Si nunca lo hace, revisa Ajustes → Instalación, o desactiva iCloud Private Relay e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez quelques secondes qu'iOS demande. Si ce n'est jamais le cas, vérifiez Paramètres → Installation, ou désactivez iCloud Private Relay et réessayez."
