    "Sign in with your Accretion store account to back up your certificates. They're sealed on this iPhone with a passphrase only you know before anything is uploaded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit Ihrem Accretion-Store-Account an, um Ihre Zertifikate zu sichern. Sie werden auf diesem iPhone mit einer Passphrase versiegelt, die nur Sie kennen, bevor etwas hochgeladen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu cuenta de la tienda Accretion para hacer una copia de seguridad de tus certificados. Se sellan en este iPhone con una frase de contraseña que solo tú conoces antes de subirse nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte Accretion Store pour sauvegarder vos certificats. Ils sont scellés sur cet iPhone avec une phrase de passe que seul vous connaissez avant tout envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account dello store Accretion per eseguire il backup dei tuoi certificati. Vengono sigillati su questo iPhone con una passphrase che solo tu conosci prima che venga caricato qualcosa."
          }
        }
      }
    },
    "Sign in with your Apple ID in Settings → Apple ID." : {
