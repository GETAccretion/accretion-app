    "Installs work without the internet, using a certificate made on this iPhone. Needs a one-time setup." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل التثبيت بدون إنترنت، باستخدام شهادة تم إنشاؤها على هذا iPhone. يحتاج إلى إعداد لمرة واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalace fungují bez internetu pomocí certifikátu vytvořeného na tomto iPhone. Vyžaduje jednorázové nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationen funktionieren ohne Internet, mit einem auf diesem iPhone erstellten Zertifikat. Erfordert eine einmalige Einrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las instalaciones funcionan sin internet, usando un certificado creado en este iPhone. Requiere una configuración única."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les installations fonctionnent sans internet, en utilisant un certificat créé sur cet iPhone. Nécessite une configuration unique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemasangan berfungsi tanpa internet, menggunakan sertifikat yang dibuat di iPhone ini. Memerlukan pengaturan sekali saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le installazioni funzionano senza internet, usando un certificato creato su questo iPhone. Richiede una configurazione una tantum."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 없이 설치가 작동하며, 이 iPhone에서 만든 인증서를 사용합니다. 일회성 설정이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalacje działają bez internetu, używając certyfikatu utworzonego na tym iPhone. Wymaga jednorazowej konfiguracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка работает без интернета, используя сертификат, созданный на этом iPhone. Требуется разовая настройка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
