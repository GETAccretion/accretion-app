    "%@ can't be signed because they're still encrypted. The app may still work; remove them under Advanced → Modify → Frameworks & PlugIns if signing fails." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ können nicht signiert werden, da sie noch verschlüsselt sind. Die App funktioniert möglicherweise trotzdem; unter Erweitert → Modifizieren → Frameworks & PlugIns entfernen, falls das Signieren fehlschlägt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se pueden firmar porque siguen cifradas. Es posible que la app funcione igualmente; si falla la firma, elimínalas en Avanzado → Modificar → Frameworks y PlugIns."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être signé car il est encore chiffré. L'app peut quand même fonctionner ; supprimez‑les sous Avancé → Modifier → Frameworks & PlugIns si la signature échoue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non possono essere firmati perché sono ancora crittografati. L'app potrebbe comunque funzionare; rimuovili in Avanzate → Modifica → Frameworks & PlugIns se la firma fallisce."
          }
        }
      }
    },
