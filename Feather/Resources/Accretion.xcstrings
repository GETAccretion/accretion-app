    "Signed by a different team than the installed copies, so iOS needs these deleted from the Home Screen before installing (their data is lost): %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem anderen Team signiert als die installierten Kopien, daher muss iOS diese vom Home-Bildschirm löschen, bevor sie installiert werden können (ihre Daten gehen verloren): %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmadas por un equipo distinto al de las copias instaladas, por lo que iOS requiere eliminarlas de la pantalla de inicio antes de instalar (se perderán sus datos): %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signé par une équipe différente de celle des copies installées, iOS doit donc les supprimer de l'écran d'accueil avant l'installation (leurs données seront perdues) : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmato da un team diverso rispetto alle copie installate, quindi iOS richiede che queste vengano eliminate dalla Schermata Home prima di installare (i loro dati andranno persi): %@"
          }
        }
      }
    },
