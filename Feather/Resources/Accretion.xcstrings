    "Apple has revoked the certificate you sign with, so apps signed with it will stop opening. Import or pick another certificate in Settings → Certificates, then use Re-sign All from the ✨ menu in Library." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat das Zertifikat widerrufen, mit dem Sie signieren, sodass damit signierte Apps nicht mehr öffnen. Importieren Sie in Einstellungen → Zertifikate ein anderes Zertifikat oder wählen Sie eines aus, und verwenden Sie dann „Alles neu signieren“ aus dem ✨-Menü in der Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha revocado el certificado con el que firmas, por lo que las apps firmadas con él dejarán de abrirse. Importa o elige otro certificado en Ajustes → Certificados y luego usa Volver a firmar todo en el menú ✨ de Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a révoqué le certificat que vous utilisez pour signer, donc les applications signées avec ne s'ouvriront plus. Importez ou choisissez un autre certificat dans Paramètres → Certificats, puis utilisez Re-signer tout depuis le menu ✨ dans Bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha revocato il certificato con cui firmi, quindi le app firmate con esso smetteranno di aprirsi. Importa o scegli un altro certificato in Impostazioni → Certificati, poi usa Ri-firma tutto dal menu ✨ in Libreria."
          }
        }
      }
    },
    "Apple has revoked this certificate, so apps signed with it won't open. Pick another certificate, or ask your seller for a replacement." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat dieses Zertifikat widerrufen, daher öffnen sich damit signierte Apps nicht. Ein anderes Zertifikat wählen oder den Verkäufer um Ersatz bitten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha revocado este certificado, por lo que las apps firmadas con él dejarán de abrirse. Elige otro certificado o pide un reemplazo a quien te lo vendió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a révoqué ce certificat, donc les apps signées avec ne s'ouvriront pas. Choisissez un autre certificat, ou demandez un remplacement à votre vendeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha revocato questo certificato, quindi le app firmate con esso non si apriranno. Scegli un altro certificato, o chiedi al venditore una sostituzione."
          }
        }
      }
    },
    "Apple ID (7 days)" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
