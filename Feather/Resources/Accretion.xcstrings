    "iOS started a secure connection to the install server but asked for nothing: it didn't accept the certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat eine sichere Verbindung zum Installationsserver gestartet, aber nichts angefragt: Es hat das Zertifikat nicht akzeptiert."
