    "Made once on a computer with the phone on USB, then imported here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إنشاؤه مرة واحدة على جهاز كمبيوتر مع توصيل الهاتف عبر USB، ثم يُستورد هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořen jednou na počítači s telefonem na USB, pak importován sem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal auf einem Computer mit dem iPhone per USB erstellt, dann hier importiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crea una vez en un ordenador con el iPhone por USB y luego se importa aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créé une fois sur un ordinateur avec le téléphone en USB, puis importé ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuat sekali di komputer dengan ponsel di USB, lalu diimpor ke sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creato una volta su un computer con il telefono collegato via USB, poi importato qui."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 USB로 iPhone 연결 후 한 번 생성한 뒤, 여기로 가져옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzony raz na komputerze z telefonem podłączonym USB, potem importowany tutaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаётся один раз на компьютере с подключённым по USB телефоном, затем импортируется сюда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon USB ile bağlıyken bir kez bilgisayarda oluşturulur, sonra buraya içe aktarılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo một lần trên máy tính với điện thoại kết nối USB, sau đó nhập vào đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在电脑上通过 USB 连接手机制作一次，然后导入此处。"
          }
        }
      }
    },
