    "Uses backloop.dev's public certificate. If iOS no longer accepts it, installs switch to another mode automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم شهادة backloop.dev العامة. إذا لم يعد iOS يقبلها، يتحول التثبيت إلى وضع آخر تلقائياً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá veřejný certifikát backloop.dev. Pokud iOS ho přestane přijímat, instalace se automaticky přepnou do jiného režimu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet das öffentliche Zertifikat von backloop.dev. Wenn iOS es nicht mehr akzeptiert, wechseln Installationen automatisch in einen anderen Modus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el certificado público de backloop.dev. Si iOS ya no lo acepta, las instalaciones cambian a otro modo automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le certificat public de backloop.dev. Si iOS ne l'accepte plus, les installations passent automatiquement à un autre mode."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan sertifikat publik backloop.dev. Jika iOS tidak lagi menerimanya, pemasangan akan beralih ke mode lain secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il certificato pubblico di backloop.dev. Se iOS non lo accetta più, le installazioni passano automaticamente a un'altra modalità."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "backloop.dev의 공개 인증서를 사용합니다. iOS가 더 이상 이를 허용하지 않으면 설치가 자동으로 다른 모드로 전환됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa publicznego certyfikatu backloop.dev. Jeśli iOS przestanie go akceptować, instalacje automatycznie przełączą się na inny tryb."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется публичный сертификат backloop.dev. Если iOS перестанет его принимать, установки автоматически переключатся на другой режим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "backloop.dev'in genel sertifikasını kullanır. iOS artık kabul etmezse, yüklemeler otomatik olarak başka bir moda geçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng chứng chỉ công khai của backloop.dev. Nếu iOS không còn chấp nhận, cài đặt sẽ tự động chuyển sang chế độ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 backloop.dev 的公共证书。如果 iOS 不再接受该证书，安装将自动切换到另一种模式。"
          }
        }
      }
    },
    "Using the name, icon, tweaks and properties saved for this app. Tap Reset to start from your defaults." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم استخدام الاسم، الأيقونة، التعديلات، والخصائص المحفوظة لهذا التطبيق. اضغط على إعادة تعيين للبدء من الإعدادات الافتراضية الخاصة بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se jméno, ikona, tweaky a nastavení uložená pro tuto aplikaci. Klepněte na Resetovat pro začátek od vašich výchozích hodnot."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet den Namen, das Symbol, Tweaks und Eigenschaften, die für diese App gespeichert sind. Tippe auf „Zurücksetzen“, um von deinen Standardwerten auszugehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando el nombre, icono, tweaks y propiedades guardados para esta app. Pulsa Reiniciar para empezar desde tus valores por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation du nom, de l'icône, des tweaks et des propriétés enregistrés pour cette application. Touchez Réinitialiser pour repartir de vos valeurs par défaut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan nama, ikon, tweak, dan properti yang disimpan untuk aplikasi ini. Ketuk Atur Ulang untuk memulai dari default Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza il nome, l'icona, le modifiche e le proprietà salvate per questa app. Tocca Ripristina per ricominciare dalle impostazioni predefinite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱에 저장된 이름, 아이콘, 트윅 및 속성을 사용 중입니다. 재설정을 탭해 기본값부터 시작하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa nazwy, ikony, tweaków i właściwości zapisanych dla tej aplikacji. Dotknij Resetuj, aby zacząć od Twoich ustawień domyślnych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используются имя, иконка, твики и свойства, сохранённые для этого приложения. Нажмите «Сброс», чтобы начать с ваших настроек по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama için kaydedilen ad, simge, yamalar ve özellikler kullanılıyor. Varsayılanlarınıza dönmek için Sıfırla'ya dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng tên, biểu tượng, tweaks và thuộc tính đã lưu cho ứng dụng này. Chạm Đặt lại để bắt đầu từ mặc định của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用为此应用保存的名称、图标、插件和属性。点击重置以从您的默认值开始。"
          }
        }
      }
    },
    "Usually app extensions a single-app certificate can't cover. Accretion leaves them out automatically; update to the newest Accretion." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادةً ما تكون امتدادات التطبيقات غير مدعومة بشهادة التطبيق الواحد. يتخلى عنها Accretion تلقائياً؛ حدث إلى أحدث إصدار من Accretion."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvykle jde o rozšíření aplikace, které certifikát pro jednu aplikaci nemůže pokrýt. Accretion je automaticky vynechává; aktualizujte na nejnovější Accretion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meistens App-Erweiterungen, die ein Einzel-App-Zertifikat nicht abdecken kann. Accretion lässt sie automatisch weg; auf die neueste Accretion-Version aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente son extensiones de app que un certificado de una sola app no puede cubrir. Accretion las omite automáticamente; actualiza a la versión más reciente de Accretion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Généralement des extensions d'app qu'un certificat pour app unique ne peut pas couvrir. Accretion les exclut automatiquement ; mettez à jour vers la dernière version d'Accretion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biasanya ekstensi aplikasi yang tidak dicakup sertifikat satu-aplikasi. Accretion mengecualikannya secara otomatis; perbarui ke Accretion terbaru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito sono estensioni dell'app che un certificato per singola app non può coprire. Accretion le esclude automaticamente; aggiorna all'ultima versione di Accretion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보통 단일 앱 인증서로는 앱 확장을 포함할 수 없습니다. Accretion이 자동으로 제외합니다. 최신 Accretion으로 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazwyczaj to rozszerzenia aplikacji, których certyfikat dla pojedynczej aplikacji nie obejmuje. Accretion automatycznie je pomija; zaktualizuj do najnowszego Accretion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно это расширения приложения, которые не покрывает сертификат для одного приложения. Accretion автоматически исключает их; обновите Accretion до последней версии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle tek uygulama sertifikasının kapsayamadığı uygulama uzantılarıdır. Accreton onları otomatik olarak hariç tutar; en yeni Accreton'a güncelleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thường là tiện ích mở rộng ứng dụng mà chứng chỉ một ứng dụng không bao gồm. Accretion tự động loại bỏ chúng; hãy cập nhật lên Accretion mới nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常是单一应用证书无法覆盖的应用扩展。Accretion 会自动排除它们；请更新到最新版 Accretion。"
          }
        }
      }
    },
