    "On this iOS, Open with JIT hands the app to StikDebug instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على هذا الإصدار من iOS، يسلم \"فتح مع JIT\" التطبيق إلى StikDebug بدلاً من ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto iOS Otevřít s JIT předá aplikaci StikDebugu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iOS übergibt „Mit JIT öffnen“ die App an StikDebug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este iOS, Abrir con JIT pasa la app a StikDebug."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur cet iOS, Ouvrir avec JIT confie l'app à StikDebug."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada iOS ini, Buka dengan JIT menyerahkan aplikasi ke StikDebug sebagai gantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo iOS, Apri con JIT passa l'app a StikDebug."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iOS에서는 JIT로 열기가 앱을 StikDebug로 넘깁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym iOS Otwórz z JIT przekazuje aplikację do StikDebug."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой версии iOS «Открыть с JIT» передаёт приложение в StikDebug."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iOS sürümünde, JIT ile Aç uygulamayı StikDebug'e aktarır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên iOS này, Mở với JIT sẽ chuyển ứng dụng cho StikDebug thay vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
