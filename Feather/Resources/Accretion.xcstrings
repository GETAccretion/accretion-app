    "iOS trusts this iPhone's install certificate. Installs work without the internet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يثق iOS في شهادة تثبيت هذا الـ iPhone. يعمل التثبيت دون إنترنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS důvěřuje instalačnímu certifikátu tohoto iPhone. Instalace fungují bez internetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
