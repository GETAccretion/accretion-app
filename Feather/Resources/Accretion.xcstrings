    "LiveContainer runs apps inside itself, so a certificate that covers one app can hold many. Install it once with your certificate, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer führt Apps in sich selbst aus, sodass ein Zertifikat, das eine App abdeckt, viele enthalten kann. Einmal mit Ihrem Zertifikat installieren, dann erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer ejecuta las apps dentro de sí mismo, así que un certificado que cubre una sola app puede alojar muchas. Instálalo una vez con tu certificado y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer exécute les apps en son sein, donc un certificat qui couvre une app peut en contenir plusieurs. Installez‑le une fois avec votre certificat, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer esegue le app al suo interno, così un certificato che copre un'app può contenerne molte. Installalo una volta con il tuo certificato, poi riprova."
          }
        }
      }
    },
