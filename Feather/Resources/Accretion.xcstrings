          }
        }
      }
    },
    "Usually app extensions a single-app certificate can't cover. Accretion leaves them out automatically; update to the newest Accretion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meistens App-Erweiterungen, die ein Einzel-App-Zertifikat nicht abdecken kann. Accretion lässt sie automatisch weg; auf die neueste Accretion-Version aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente son extensiones de app que un certificado de una sola app no puede cubrir. Accretion las omite automáticamente; actualiza a la versión más reciente de Accretion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Généralement des extensions d'app qu'un certificat pour app unique ne peut pas couvrir. Accretion les exclut automatiquement ; mettez à jour vers la dernière version d'Accretion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito sono estensioni dell'app che un certificato per singola app non può coprire. Accretion le esclude automaticamente; aggiorna all'ultima versione di Accretion."
          }
        }
      }
    },
