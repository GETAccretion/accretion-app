    "Choose a passphrase of at least 8 characters. You'll need it to restore; it can't be recovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر عبارة مرور من ٨ أحرف على الأقل. ستحتاجها للاستعادة؛ لا يمكن استعادتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte heslovou frázi alespoň 8 znaků. Budete ji potřebovat k obnovení; nedá se obnovit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Passphrase mit mindestens 8 Zeichen. Du brauchst sie zur Wiederherstellung; sie kann nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una frase de acceso de al menos 8 caracteres. La necesitarás para restaurar; no se puede recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une phrase secrète d'au moins 8 caractères. Elle sera nécessaire pour restaurer ; elle ne peut pas être récupérée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih frasa sandi minimal 8 karakter. Anda membutuhkannya untuk memulihkan; tidak dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una passphrase di almeno 8 caratteri. Ti servirà per ripristinare; non può essere recuperata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 8자 이상의 암호를 선택하세요. 복원에 필요하며 복구할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz hasło o długości co najmniej 8 znaków. Będzie potrzebne do przywrócenia; nie da się go odzyskać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите кодовую фразу не короче 8 символов. Она понадобится для восстановления; восстановить её нельзя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az 8 karakterli bir parola seçin. Geri yüklemek için gerekecek; kurtarılamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một cụm mật khẩu ít nhất 8 ký tự. Bạn sẽ cần nó để khôi phục; không thể khôi phục nếu mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择至少 8 个字符的密码短语。您需要它来恢复；无法找回。"
