    "%@ can't be signed because they're still encrypted. The app may still work; remove them under Advanced → Modify → Frameworks & PlugIns if signing fails." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن توقيع %@ لأنها لا تزال مشفرة. قد يعمل التطبيق على أي حال؛ احذفها ضمن متقدم → تعديل → Frameworks & PlugIns إذا فشل التوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nelze podepsat, protože jsou stále zašifrované. Aplikace stále může fungovat; odeberte je v Pokročilé → Modifikovat → Frameworks & PlugIns, pokud podepisování selže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ können nicht signiert werden, da sie noch verschlüsselt sind. Die App funktioniert möglicherweise trotzdem; unter Erweitert → Modifizieren → Frameworks & PlugIns entfernen, falls das Signieren fehlschlägt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se pueden firmar porque siguen cifradas. Es posible que la app funcione igualmente; si falla la firma, elimínalas en Avanzado → Modificar → Frameworks y PlugIns."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être signé car il est encore chiffré. L'app peut quand même fonctionner ; supprimez‑les sous Avancé → Modifier → Frameworks & PlugIns si la signature échoue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak dapat ditandatangani karena masih terenkripsi. Aplikasi mungkin tetap berfungsi; hapus di Lanjutan → Ubah → Frameworks & PlugIns jika penandatanganan gagal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non possono essere firmati perché sono ancora crittografati. L'app potrebbe comunque funzionare; rimuovili in Avanzate → Modifica → Frameworks & PlugIns se la firma fallisce."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 여전히 암호화되어 있어 서명할 수 없습니다. 앱은 여전히 작동할 수 있습니다. 서명에 실패하면 고급 → 수정 → 프레임워크 및 플러그인에서 제거하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie można podpisać, bo wciąż są zaszyfrowane. Aplikacja może nadal działać; usuń je w Zaawansowane → Modyfikuj → Frameworki i wtyczki, jeśli podpisywanie się nie uda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ нельзя подписать, так как они всё ещё зашифрованы. Приложение может работать; удалите их в Advanced → Modify → Frameworks & PlugIns, если подпись не удаётся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hala şifreli olduğu için imzalanamaz. Uygulama yine de çalışabilir; imzalama başarısız olursa İleri Düzey → Değiştir → Çerçeveler ve Eklentiler altından kaldırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thể ký vì chúng vẫn được mã hóa. Ứng dụng vẫn có thể hoạt động; xóa chúng trong Nâng cao → Chỉnh sửa → Frameworks & PlugIns nếu ký thất bại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法签名，因为它们仍处于加密状态。App 可能仍能运行；若签名失败，请在“高级”→“自定义”→“框架与插件”中移除它们。"
          }
        }
      }
    },
