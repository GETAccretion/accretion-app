    "public AltStore and SideStore sources, merged and cleaned. One entry per app, always the newest version." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصادر AltStore و SideStore العامة، مدمجة ومنقاة. إدخال واحد لكل تطبيق، دائماً بأحدث إصدار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "veřejné zdroje AltStore a SideStore, sloučené a vyčištěné. Jedna položka na aplikaci, vždy nejnovější verze."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "öffentliche AltStore- und SideStore-Quellen, zusammengeführt und bereinigt. Ein Eintrag pro App, immer die neueste Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fuentes públicas de AltStore y SideStore, combinadas y depuradas. Una entrada por app, siempre la versión más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sources publiques AltStore et SideStore, fusionnées et nettoyées. Une entrée par app, toujours la version la plus récente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sumber AltStore dan SideStore publik, digabung dan dibersihkan. Satu entri per aplikasi, selalu versi terbaru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fonti pubbliche di AltStore e SideStore, unite e ripulite. Una voce per app, sempre la versione più recente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 AltStore 및 SideStore 소스를 병합 및 정리했습니다. 앱당 하나의 항목만 표시되며, 항상 최신 버전입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "publiczne źródła AltStore i SideStore, scalone i oczyszczone. Jeden wpis na aplikację, zawsze najnowsza wersja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "публичные источники AltStore и SideStore, объединённые и очищенные. Одна запись на приложение, всегда самая новая версия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel AltStore ve SideStore kaynakları, birleştirilmiş ve temizlenmiş. Uygulama başına bir giriş, her zaman en yeni sürüm."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nguồn AltStore và SideStore công khai, đã gộp và làm sạch. Mỗi ứng dụng một mục, luôn phiên bản mới nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公开的 AltStore 和 SideStore 软件源，经合并去重。每个应用仅保留一条记录，始终为最新版本。"
          }
        }
      }
    },
