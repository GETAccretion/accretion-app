    "The whole index at a glance. Rebuilt every 6 hours from every source." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفهرس بالكامل بنظرة واحدة. يُعاد بناؤه كل 6 ساعات من كل مصدر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celý index zlehka. Přeindexováno každých 6 hodin ze všech zdrojů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der komplette Index auf einen Blick. Alle 6 Stunden aus allen Quellen neu erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el índice de un vistazo. Se reconstruye cada 6 horas desde cada fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout l'index en un coup d'œil. Reconstruit toutes les 6 heures à partir de toutes les sources."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seluruh indeks sekilas. Dibangun ulang setiap 6 jam dari setiap sumber."
