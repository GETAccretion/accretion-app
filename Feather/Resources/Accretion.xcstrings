    "If any issues occur within the app please report it via the GitHub repository. When submitting an issue, make sure to submit detailed information." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud v aplikaci nastanou problémy, nahlásíte je prosím v GitHubovém repozitáři. Při podávání problému ujistěte se, že poskytnete podrobné informace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ocurre algún problema en la app, por favor repórtalo en el repositorio de GitHub. Al enviar un problema, asegúrate de incluir información detallada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un problème survient dans l'app, signalez-le via le dépôt GitHub. Lors de l'envoi d'un problème, veillez à fournir des informations détaillées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika terjadi masalah di dalam aplikasi, laporkan melalui repositori GitHub. Saat mengirimkan masalah, pastikan untuk menyertakan informasi rinci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если в приложении возникнут проблемы, сообщите о них через репозиторий GitHub. При создании задачи обязательно укажите подробную информацию."
          }
        }
      }
    },
