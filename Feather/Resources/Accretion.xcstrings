    "Each app gets a fresh 7-day profile. iOS asks to confirm each install." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل كل تطبيق على ملف تعريف جديد لمدة 7 أيام. يطلب iOS تأكيد كل تثبيت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá aplikace dostane nový 7denní profil. iOS se zeptá na potvrzení každé instalace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App erhält ein frisches 7-Tage-Profil. iOS fragt bei jeder Installation nach Bestätigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada app obtiene un perfil nuevo de 7 días. iOS pide confirmar cada instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque app obtient un nouveau profil de 7 jours. iOS demande de confirmer chaque installation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap aplikasi mendapatkan profil 7 hari baru. iOS meminta konfirmasi untuk setiap instalasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni app riceve un profilo fresco di 7 giorni. iOS chiede di confermare ogni installazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 앱마다 새로운 7일 프로필이 발급됩니다. iOS가 각 설치를 확인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda aplikacja otrzymuje nowy 7-dniowy profil. iOS prosi o potwierdzenie każdej instalacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое приложение получает новый профиль на 7 дней. iOS попросит подтвердить каждую установку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uygulama yeni 7 günlük bir profil alır. iOS her kurulumu onaylamak ister."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi ứng dụng nhận hồ sơ 7 ngày mới. iOS yêu cầu xác nhận mỗi lần cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个应用获得一个全新的 7 天描述文件。iOS 会要求确认每次安装。"
          }
        }
      }
    },
