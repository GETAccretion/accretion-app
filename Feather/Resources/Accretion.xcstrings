    "Imported. Make a new one if the phone is restored or re-paired." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الاستيراد. أنشئ ملفاً جديداً إذا تمت استعادة الهاتف أو إعادة إقرانه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importováno. Vytvořte nový, pokud je telefon obnoven nebo znovu spárován."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiert. Neue erstellen, wenn das iPhone wiederhergestellt oder neu gekoppelt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importado. Crea uno nuevo si el iPhone se restaura o se vuelve a emparejar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importé. Créez-en un nouveau si le téléphone est restauré ou réappairé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telah Diimpor. Buat baru jika ponsel dipulihkan atau dipasangkan ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importato. Ne crea uno nuovo se il telefono viene ripristinato o riassociato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져옴. iPhone을 복원하거나 다시 페어링하면 새로 만드세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportowano. Utwórz nowy, jeśli telefon został przywrócony lub sparowany ponownie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортирован. Создайте новый, если телефон восстановлен или повторно сопряжён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarıldı. Telefon yeniden kurulduysa veya yeniden eşleştirildiyse yenisini oluşturun."
