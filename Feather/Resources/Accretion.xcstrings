    "Saves the name, icon, tweaks and properties so updates and re-signs keep them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ الاسم، الأيقونة، التعديلات والخصائص حتى تحتفظ التحديثات وإعادة التوقيع بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
