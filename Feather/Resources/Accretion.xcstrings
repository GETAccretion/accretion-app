    "Export makes an unsigned IPA with the tweaks inside, to sign with any tool. Only use apps you own, and keep mods out of online games." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export erstellt eine unsignierte IPA mit den Tweaks darin, um sie mit jedem Tool zu signieren. Nur eigene Apps verwenden und Mods aus Online-Spielen fernhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar crea un IPA sin firmar con los tweaks dentro, para firmar con cualquier herramienta. Usa solo apps tuyas y mantén los mods fuera de juegos online."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exportation crée une IPA non signée avec les tweaks à l'intérieur, à signer avec n'importe quel outil. N'utilisez que vos propres apps, et gardez les mods hors des jeux en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esportazione crea un IPA non firmato con le modifiche all'interno, da firmare con qualsiasi strumento. Usa solo app di tua proprietà e tieni le mod fuori dai giochi online."
          }
        }
