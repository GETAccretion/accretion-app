        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il certificato pubblico di backloop.dev. Se iOS non lo accetta più, le installazioni passano automaticamente a un'altra modalità."
          }
        }
      }
    },
    "Using the name, icon, tweaks and properties saved for this app. Tap Reset to start from your defaults." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
