    "Try removing PlugIns (Advanced → Modify → Frameworks & PlugIns), or check the certificate hasn't expired." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول إزالة الإضافات (متقدم ← تعديل ← الإطارات البرمجية والإضافات)، أو تأكد من أن الشهادة لم تنته صلاحيتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste odebrat PlugIns (Pokročilé → Modifikovat → Frameworky a PlugIns), nebo zkontrolujte, že certifikát nevypršel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuch, PlugIns zu entfernen (Erweitert → Modifizieren → Frameworks & PlugIns), oder prüfen, ob das Zertifikat nicht abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta eliminar PlugIns (Avanzado → Modificar → Frameworks y PlugIns), o verifica que el certificado no haya expirado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de supprimer les PlugIns (Avancé → Modifier → Frameworks et PlugIns), ou vérifiez que le certificat n'a pas expiré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba hapus PlugIns (Lanjutan → Ubah → Framework & PlugIns), atau periksa sertifikat belum kedaluwarsa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a rimuovere i PlugIns (Avanzate → Modifica → Frameworks e PlugIns), o verifica che il certificato non sia scaduto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인 제거를 시도하세요 (고급 → 수정 → 프레임워크 및 플러그인). 또는 인증서가 만료되지 않았는지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj usunąć PlugIns (Zaawansowane → Modyfikuj → Frameworki i PlugIns) lub sprawdź, czy certyfikat nie wygasł."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте удалить PlugIns (Дополнительно → Изменить → Фреймворки и PlugIns), или проверьте, не истёк ли сертификат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentileri kaldırmayı deneyin (İleri Düzey → Değiştir → Çerçeveler ve Eklentiler), veya sertifikanın süresi dolmadığını kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thử loại bỏ PlugIns (Nâng cao → Chỉnh sửa → Frameworks & PlugIns), hoặc kiểm tra chứng chỉ chưa hết hạn."
          }
        },
        "zh-Hans" : {
