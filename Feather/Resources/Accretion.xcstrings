    "%@ restored. Find it in Settings → Certificates." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wiederhergestellt. Finde es in Einstellungen → Zertifikate."
          }
        },
        "es" : {
