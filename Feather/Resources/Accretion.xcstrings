    "iOS never completed a connection to the install server." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat keine Verbindung zum Installationsserver hergestellt."
          }
