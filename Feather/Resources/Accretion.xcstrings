    "%@ sources feed Accretion. \"Apps\" counts the apps where that source has the newest version." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مصادر تغذي Accretion. \"التطبيقات\" تحسب التطبيقات التي يكون فيها ذلك المصدر أحدث إصدار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zdrojů dodává Accretion. \"Aplikace\" počítá aplikace, kde tento zdroj má nejnovější verzi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Quellen versorgen Accretion. \"Apps\" zählt die Apps, bei denen diese Quelle die neueste Version hat."
