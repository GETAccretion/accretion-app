        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainstalujte aktualizaci nástrojem, kterým jste nainstalovali Accretion, například podepisovačem od prodejce certifikátu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere das Update mit dem Tool, das du zum Installieren von Accretion verwendet hast, zum Beispiel dem Signer deines Zertifikatverkäufers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala la actualización con la herramienta que usaste para instalar Accretion, por ejemplo, el firmador de tu vendedor de certificados."
          }
