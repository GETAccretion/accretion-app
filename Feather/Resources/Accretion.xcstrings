    "Signed in? Settings → Account backs your certificate up to your account, sealed with a passphrase, so you can restore it on a new iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet? Einstellungen → Account sichert dein Zertifikat in deinem Account, verschlüsselt mit einer Passphrase, damit du es auf einem neuen iPhone wiederherstellen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has iniciado sesión? Ajustes → Cuenta respalda tu certificado en tu cuenta, protegido con una frase de contraseña, para que puedas restaurarlo en un iPhone nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté ? Paramètres → Compte sauvegarde votre certificat dans votre compte, scellé par une phrase de passe, pour que vous puissiez le restaurer sur un nouvel iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato l'accesso? Impostazioni → Account salva una copia del certificato nel tuo account, protetta da una passphrase, così puoi ripristinarla su un nuovo iPhone."
          }
        }
      }
    },
