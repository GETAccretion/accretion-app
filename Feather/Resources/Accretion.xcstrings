        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto l'indice a colpo d'occhio. Ricostruito ogni 6 ore da ogni fonte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 인덱스를 한눈에. 모든 소스에서 6시간마다 재구성됩니다."
