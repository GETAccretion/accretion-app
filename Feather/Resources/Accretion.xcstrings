    "The debugger couldn't attach (%@). The app must be signed with a certificate that allows a debugger (a development certificate)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر ربط المصحح (%@). يجب أن يكون التطبيق موقعاً بشهادة تسمح بمصحح (شهادة تطوير)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugger se nepodařilo připojit (%@). Aplikace musí být podepsána certifikátem, který umožňuje debugger (vývojový certifikát)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Debugger konnte nicht angehängt werden (%@). Die App muss mit einem Zertifikat signiert sein, das einen Debugger erlaubt (ein Entwicklungszertifikat)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar el depurador (%@). La app debe estar firmada con un certificado que permita un depurador (un certificado de desarrollo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le débogueur n'a pas pu s'attacher (%@). L'app doit être signée avec un certificat qui autorise un débogueur (un certificat de développement)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugger tidak dapat terpasang (%@). Aplikasi harus ditandatangani dengan sertifikat yang mengizinkan debugger (sertifikat pengembangan)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il debugger non è riuscito a collegarsi (%@). L'app deve essere firmata con un certificato che permetta un debugger (un certificato di sviluppo)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버거를 연결할 수 없습니다 (%@). 이 앱은 디버거를 허용하는 인증서(개발용 인증서)로 서명되어야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debuger nie mógł się podłączyć (%@). Aplikacja musi zostać podpisana certyfikatem pozwalającym na debuger (certyfikatem deweloperskim)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отладчик не смог подключиться (%@). Приложение должно быть подписано сертификатом, разрешающим отладчик (сертификат разработчика)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata ayıklayıcı bağlanamadı (%@). Uygulama, hata ayıklayıcıya izin veren bir sertifikayla (geliştirme sertifikası) imzalanmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình gỡ lỗi không thể gắn kết (%@). Ứng dụng phải được ký bằng chứng chỉ cho phép trình gỡ lỗi (chứng chỉ phát triển)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试器无法附加 (%@)。App 必须使用允许调试器的证书签名（开发者证书）。"
          }
        }
      }
    },
