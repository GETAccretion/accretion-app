        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać certyfikatu instalacji. Naciśnij Aktualizuj certyfikaty SSL w Ustawieniach → Instalacja → Serwer i SSL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат установки не может быть прочитан. Нажмите «Обновить SSL-сертификаты» в Настройки → Установка → Сервер и SSL."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme sertifikası okunamıyor. Ayarlar → Yükleme → Sunucu ve SSL'ye gidin ve SSL Sertifikalarını Güncelle'ye dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc chứng chỉ cài đặt. Nhấn Cập nhật Chứng chỉ SSL trong Cài đặt → Cài đặt → Máy chủ & SSL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
