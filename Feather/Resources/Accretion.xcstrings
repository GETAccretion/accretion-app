    "Backups are sealed with your passphrase before upload. Accretion can't read them or recover a lost passphrase." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير النسخ الاحتياطية بعبارة المرور الخاصة بك قبل الرفع. لا تستطيع Accretion قراءتها أو استعادة عبارة مرور مفقودة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohy jsou uzamčeny vaší heslovou frází před nahráním. Accretion je nemůže přečíst ani obnovit ztracenou heslovou frázi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups werden vor dem Hochladen mit deiner Passphrase versiegelt. Accretion kann sie nicht lesen oder eine verlorene Passphrase wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se sellan con tu frase de acceso antes de subirlas. Accretion no puede leerlas ni recuperar una frase de acceso perdida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont scellées avec votre phrase secrète avant l'envoi. Accretion ne peut ni les lire ni récupérer une phrase secrète perdue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan disejel dengan frasa sandi Anda sebelum diunggah. Accretion tidak dapat membacanya atau memulihkan frasa sandi yang hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup vengono sigillati con la tua passphrase prima del caricamento. Accretion non può leggerli né recuperare una passphrase persa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 업로드 전에 암호로 봉인됩니다. Accretion은 이를 읽거나 분실한 암호를 복구할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie zapasowe są zabezpieczane hasłem przed wysłaniem. Accretion nie może ich odczytać ani odzyskać utraconego hasła."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии запечатываются вашей кодовой фразой перед загрузкой. Accretion не может их прочитать или восстановить утерянную фразу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekler yüklenmeden önce parolanızla şifrelenir. Accretion bunları okuyamaz veya kaybolan parolayı kurtaramaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản sao lưu được bảo mật bằng cụm mật khẩu của bạn trước khi tải lên. Accretion không thể đọc chúng hoặc khôi phục cụm mật khẩu đã mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份在上传前会使用您的密码短语加密封存。Accretion 无法读取它们，也无法恢复丢失的密码短语。"
          }
        }
      }
    },
