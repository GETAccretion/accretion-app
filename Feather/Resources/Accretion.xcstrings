    "Accretion %@ is no longer supported. Version %@ or newer is needed to keep using the store, downloads and signing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ لم يعد مدعومًا. يلزم الإصدار %@ أو أحدث لمواصلة استخدام المتجر والتنزيلات والتوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ již není podporován. Verze %@ nebo novější je potřeba pro pokračování používání obchodu, stahování a podpisování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ wird nicht mehr unterstützt. Version %@ oder neuer wird benötigt, um den Store, Downloads und Signierung weiterhin nutzen zu können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ ya no es compatible. Se necesita la versión %@ o posterior para seguir usando la tienda, las descargas y la firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ n'est plus pris en charge. La version %@ ou ultérieure est nécessaire pour continuer à utiliser le store, les téléchargements et la signature."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ tidak lagi didukung. Versi %@ atau yang lebih baru diperlukan untuk terus menggunakan toko, unduhan, dan penandatanganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ non è più supportato. È necessaria la versione %@ o successiva per continuare a usare lo store, i download e la firma."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@은(는) 더 이상 지원되지 않습니다. 스토어, 다운로드 및 서명을 계속 사용하려면 버전 %@ 이상이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ nie jest już wspierany. Wersja %@ lub nowsza jest wymagana, aby nadal korzystać ze sklepu, pobierania i podpisywania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ больше не поддерживается. Версия %@ или новее требуется для использования магазина, загрузок и подписи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ artık desteklenmiyor. Mağazayı, indirmeleri ve imzalamayı kullanmaya devam etmek için %@ veya daha yeni bir sürüm gerekiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accretion %@ không còn được hỗ trợ. Cần phiên bản %@ trở lên để tiếp tục sử dụng cửa hàng, tải xuống và ký."
          }
        },
