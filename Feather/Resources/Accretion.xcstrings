          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya tienes un IPA? Ábrelo desde Archivos o descargas de Safari, pulsa Compartir y elige Accretion, o usa Biblioteca → Import."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà une IPA ? Ouvrez-la depuis Fichiers ou les téléchargements Safari, touchez Partager et choisissez Accretion, ou utilisez Bibliothèque → Importer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già un IPA? Aprilo da File o dai download di Safari, tocca Condividi e scegli Accretion, oppure usa Libreria → Importa."
