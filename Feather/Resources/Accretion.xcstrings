    },
    "It stops opening in about 2 hours. Open Accretion → Settings → Apple ID → Re-sign All." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lässt sich in ca. 2 Stunden nicht mehr öffnen. Öffnen Sie Accretion → Einstellungen → Apple ID → Alles neu signieren."
          }
        },
        "es" : {
          "stringUnit" : {
