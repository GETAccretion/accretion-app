          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки → Конфиденциальность и безопасность → Режим разработчика. Нужен для служб разработчика телефона."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar → Gizlilik ve Güvenlik → Geliştirici Modu. Telefonun geliştirici servisleri için gerekli."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt → Quyền riêng tư & Bảo mật → Chế độ nhà phát triển. Cần thiết cho dịch vụ nhà phát triển của điện thoại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 → 隐私与安全性 → 开发者模式。手机的开发者服务需要此项。"
