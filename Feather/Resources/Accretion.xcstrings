    },
    "iOS connected to the install server (for %@) but stopped at the start of the secure connection." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat eine Verbindung zum Installationsserver (für %@) hergestellt, aber beim Beginn der sicheren Verbindung abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS se conectó al servidor de instalación (para %@) pero se detuvo al inicio de la conexión segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS s'est connecté au serveur d'installation (pour %@) mais s'est arrêté au début de la connexion sécurisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS si è connesso al server di installazione (per %@) ma si è fermato all'inizio della connessione sicura."
          }
        }
      }
    },
    "iOS couldn't reach Accretion's local install server. Usually:\n\n• iCloud Private Relay, a VPN or ad-blocking DNS blocks local addresses: turn it off and try again.\n• Or switch Settings → Installation → Server to Semi Local.\n• Or this app uses the same bundle ID as Accretion itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no pudo acceder al servidor de instalación local de Accretion. Normalmente:\n\n• iCloud Private Relay, una VPN o un DNS que bloquea anuncios impide el acceso a direcciones locales: desactívalo e inténtalo de nuevo.\n• O cambia Ajustes → Instalación → Servidor a Semi Local.\n• O esta app usa el mismo bundle ID que la propia Accretion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS n'a pas pu atteindre le serveur d'installation local d'Accretion. Habituellement :\n\n• iCloud Private Relay, un VPN ou un DNS bloquant les pubs bloque les adresses locales : désactivez-le et réessayez.\n• Ou basculez Paramètres → Installation → Serveur sur Semi Local.\n• Ou cette app utilise le même bundle ID qu'Accretion lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non è riuscito a raggiungere il server di installazione locale di Accretion. Di solito:\n\n• iCloud Private Relay, una VPN o un DNS ad-blocking bloccano gli indirizzi locali: disattivali e riprova.\n• Oppure cambia in Impostazioni → Installazione → Server a Semi Local.\n• O questa app usa lo stesso bundle ID di Accretion."
          }
        }
      }
    },
