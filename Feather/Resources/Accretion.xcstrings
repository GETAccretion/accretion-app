          }
        }
      }
    },
    "%@ should point to this iPhone (127.0.0.1) but resolved to %@. iCloud Private Relay, Limit IP Address Tracking, a VPN or filtering DNS usually does this. Turn them off, or use Semi Local." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sollte auf dieses iPhone (127.0.0.1) verweisen, wurde aber zu %@ aufgelöst. iCloud Private Relay, IP-Adress-Tracking begrenzen, ein VPN oder filterndes DNS bewirkt das meist. Schalte sie aus, oder nutze Semi Local."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ debería apuntar a este iPhone (127.0.0.1) pero se resolvió como %@. Suele deberse a Relay privado de iCloud, Limitar rastreo de dirección IP, una VPN o un DNS con filtrado. Desactívalos o usa Semi Local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ devrait pointer vers cet iPhone (127.0.0.1) mais a résolu vers %@. iCloud Private Relay, Limiter le suivi de l'adresse IP, un VPN ou un DNS filtrant en sont généralement la cause. Désactivez-les, ou utilisez Semi Local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dovrebbe puntare a questo iPhone (127.0.0.1) ma ha risolto %@. iCloud Private Relay, Limita tracciamento indirizzo IP, una VPN o DNS con filtro di solito causano questo. Disattivali, o usa Semi Local."
          }
        }
      }
    },
