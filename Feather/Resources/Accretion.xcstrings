    "This IPA is still encrypted by the App Store, so it won't open after signing. Use a decrypted copy of the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال ملف IPA هذا مشفراً بواسطة App Store، لذا لن يفتح بعد التوقيع. استخدم نسخة غير مشفرة من التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto IPA je stále zašifrované App Storem, takže se neotevře po podpisu. Použijte dešifrovanou kopii aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese IPA ist noch vom App Store verschlüsselt, daher öffnet sie sich nach dem Signieren nicht. Eine entschlüsselte Kopie der App verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este IPA sigue cifrado por la App Store, por lo que no se abrirá después de firmarlo. Usa una copia descifrada de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette IPA est encore chiffrée par l'App Store, donc elle ne s'ouvrira pas après signature. Utilisez une copie déchiffrée de l'app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA ini masih terenkripsi oleh App Store, sehingga tidak akan terbuka setelah ditandatangani. Gunakan salinan aplikasi yang sudah didekripsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa IPA è ancora crittografata dall'App Store, quindi non si aprirà dopo la firma. Usa una copia decrittografata dell'app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 IPA는 여전히 App Store에 의해 암호화되어 있어 서명 후 열리지 않습니다. 앱의 복호화된 복사본을 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten IPA wciąż jest zaszyfrowany przez App Store, więc nie otworzy się po podpisaniu. Użyj odszyfrowanej kopii aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот IPA всё ещё зашифрован App Store, поэтому он не откроется после подписи. Используйте расшифрованную копию приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu IPA hala App Store tarafından şifrelenmiş, bu yüzden imzalama sonrası açılmaz. Uygulamanın şifresi çözülmüş kopyasını kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA này vẫn được mã hóa bởi App Store, nên sẽ không mở được sau khi ký. Dùng bản sao đã giải mã của ứng dụng."
