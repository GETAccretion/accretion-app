            "value" : "Fuentes de %@ que alimentan a Accretion. \"Apps\" cuenta las apps en las que esa fuente tiene la versión más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sources alimentent Accretion. \"Apps\" compte les apps où cette source a la version la plus récente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sumber mengisi feed Accretion. \"Apps\" menghitung aplikasi di mana sumber tersebut memiliki versi terbaru"
