    },
    "iOS pauses app installs while the iPhone has no network at all, even though Accretion installs from this iPhone. Join any Wi-Fi network (it doesn't need internet) or turn on cellular, then tap Install. Airplane Mode is fine with Wi-Fi on." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausa las instalaciones de apps mientras el iPhone no tenga ninguna red, aunque Accretion instale desde este iPhone. Únete a cualquier red Wi-Fi (no necesita internet) o activa los datos móviles y luego pulsa Install. El modo Avión está bien si el Wi-Fi está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS met en pause les installations d'apps tant que l'iPhone n'a aucun réseau, même si Accretion installe depuis cet iPhone. Rejoignez un réseau Wi-Fi (pas besoin d'internet) ou activez les données cellulaires, puis appuyez sur Installer. Le mode Avion est OK avec le Wi-Fi activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mette in pausa le installazioni delle app quando l'iPhone non ha alcuna rete, anche se Accretion installa da questo iPhone. Unisciti a qualsiasi rete Wi-Fi (non serve internet) o attiva la rete cellulare, poi tocca Installa. La modalità Aereo va bene con il Wi-Fi attivo."
          }
        }
      }
    },
    "iOS said the install finished, but %@ isn't on this iPhone. Try installing again; if it keeps happening, the certificate or profile may not allow this app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS meldete, die Installation sei abgeschlossen, aber %@ ist nicht auf diesem iPhone. Versuche, erneut zu installieren; falls es weiterhin auftritt, erlauben das Zertifikat oder das Profil diese App möglicherweise nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS indicó que la instalación terminó, pero %@ no está en este iPhone. Intenta instalar de nuevo; si sigue ocurriendo, es posible que el certificado o el perfil no permitan esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS indique que l'installation est terminée, mais %@ n'est pas sur cet iPhone. Réessayez d'installer ; si le problème persiste, le certificat ou le profil n'autorise peut-être pas cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS dice che l'installazione è finita, ma %@ non è su questo iPhone. Prova a installare di nuovo; se continua ad accadere, il certificato o il profilo potrebbero non permettere questa app."
          }
        }
      }
    },
