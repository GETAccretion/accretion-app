    "Need a new one? %@ certificates install apps from your iPhone, no computer needed. Affiliate link: Accretion earns a commission, at no extra cost to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauchst du ein neues? %@ Zertifikate installieren Apps von deinem iPhone, kein Computer nötig. Affiliate-Link: Accretion erhält eine Provision, ohne zusätzliche Kosten für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Necesitas uno nuevo? Los certificados de %@ instalan apps desde tu iPhone, sin necesidad de ordenador. Enlace de afiliado: Accretion recibe una comisión, sin coste adicional para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besoin d'un nouveau ? %@ certificats installent des apps depuis votre iPhone, sans ordinateur. Lien d'affiliation : Accretion touche une commission, sans coût supplémentaire pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne serve uno nuovo? I certificati %@ installano le app dal tuo iPhone, senza computer. Link affiliato: Accretion guadagna una commissione, senza costi aggiuntivi per te."
          }
        }
      }
