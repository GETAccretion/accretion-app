    "The heartbeat is activated in the background, it will restart when the app is re-opened or prompted. If the status below is pulsing, that means its healthy." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El latido se activa en segundo plano, se reiniciará al volver a abrir la app o si se solicita. Si el estado de abajo pulsa, significa que está sano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le battement de cœur est activé en arrière-plan, il redémarrera lorsque l'application sera rouverte ou sollicitée. Si le statut ci-dessous pulse, cela signifie qu'il est sain."
          }
        }
      }
    },
    "The install certificate can't be read. Tap Update SSL Certificates in Settings → Installation → Server & SSL." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Installationszertifikat kann nicht gelesen werden. Tippe auf „SSL-Zertifikate aktualisieren“ in Einstellungen → Installation → Server & SSL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer el certificado de instalación. Toca Actualizar certificados SSL en Ajustes → Instalación → Servidor y SSL."
          }
