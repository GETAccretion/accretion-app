        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato volba sloučí Entitlements se vloženými Entitlements z podepisované aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
