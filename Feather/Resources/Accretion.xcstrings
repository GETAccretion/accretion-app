    "%@ should point to this iPhone (127.0.0.1) but resolved to %@. iCloud Private Relay, Limit IP Address Tracking, a VPN or filtering DNS usually does this. Turn them off, or use Semi Local." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ يجب أن يشير إلى هذا iPhone (127.0.0.1) لكنه يشير إلى %@. عادة ما يفعل iCloud Private Relay، أو Limit IP Address Tracking، أو VPN، أو DNS التصفية هذا. أوقِفها، أو استخدم Semi Local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ by měl ukazovat na tento iPhone (127.0.0.1), ale přeložil se na %@. iCloud Private Relay, Limit IP Address Tracking, VPN nebo filtrace DNS to obvykle způsobují. Vypněte je, nebo použijte Semi Local."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sollte auf dieses iPhone (127.0.0.1) verweisen, wurde aber zu %@ aufgelöst. iCloud Private Relay, IP-Adress-Tracking begrenzen, ein VPN oder filterndes DNS bewirkt das meist. Schalte sie aus, oder nutze Semi Local."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ debería apuntar a este iPhone (127.0.0.1) pero se resolvió como %@. Suele deberse a Relay privado de iCloud, Limitar rastreo de dirección IP, una VPN o un DNS con filtrado. Desactívalos o usa Semi Local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ devrait pointer vers cet iPhone (127.0.0.1) mais a résolu vers %@. iCloud Private Relay, Limiter le suivi de l'adresse IP, un VPN ou un DNS filtrant en sont généralement la cause. Désactivez-les, ou utilisez Semi Local."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ harus mengarah ke iPhone ini (127.0.0.1) tapi terpecahkan ke %@. iCloud Private Relay, Batas Pelacakan Alamat IP, VPN atau DNS pemfilter biasanya menyebabkan ini. Matikan, atau gunakan Semi Local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dovrebbe puntare a questo iPhone (127.0.0.1) ma ha risolto %@. iCloud Private Relay, Limita tracciamento indirizzo IP, una VPN o DNS con filtro di solito causano questo. Disattivali, o usa Semi Local."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이 iPhone(127.0.0.1)을 가리켜야 하지만 %@으로 확인되었습니다. iCloud 비공개 릴레이, IP 주소 추적 제한, VPN 또는 필터링 DNS가 보통 원인입니다. 이를 끄거나 Semi Local을 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ powinien wskazywać na ten iPhone (127.0.0.1), ale wskazuje na %@. iCloud Private Relay, Ograniczenie śledzenia IP, VPN lub filtrowanie DNS zazwyczaj to powoduje. Wyłącz je lub użyj Semi Local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ должен указывать на этот iPhone (127.0.0.1), но разрешается в %@. Обычно это делают iCloud Private Relay, «Ограничить отслеживание IP», VPN или фильтрующий DNS. Отключите их или используйте Semi Local."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bu iPhone'a (127.0.0.1) işaret etmeli ama %@'e çözümlendi. iCloud Private Relay, IP Adresi Takibini Sınırla, bir VPN veya filtreleyen DNS buna genelde neden olur. Onları kapatın, veya Semi Local kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nên trỏ đến iPhone này (127.0.0.1) nhưng phân giải thành %@. iCloud Private Relay, Giới hạn theo dõi địa chỉ IP, VPN hoặc DNS lọc thường gây ra điều này. Tắt chúng đi, hoặc dùng Semi Local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 应指向此 iPhone (127.0.0.1)，但解析为 %@。iCloud Private Relay、限制 IP 地址跟踪、VPN 或过滤 DNS 通常会导致此情况。请将其关闭，或使用 Semi Local。"
          }
        }
      }
    },
